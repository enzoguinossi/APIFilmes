meta {
  name: Alterar filme
  type: http
  seq: 9
}

put {
  url: {{baseUrl}}/api/filmes/:id
  body: json
  auth: none
}

params:path {
  id: {{$randomInt}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "anoLancamento": 1964,
    "classificacaoIndicativa": "{{$randomLoremWord}}",
    "diretor": "{{$randomLoremWord}}",
    "duracaoMinutos": 300,
    "genero": "{{$randomLoremWord}}",
    "idioma": "{{$randomLocale}}",
    "nota": 5.0,
    "titulo": "{{$randomLoremWord}}"
  }
}

docs {
  Altera um filme existente no banco de dados.
  field 'diretor' must match pattern: [\\p{L}\\p{M}\\s.'-]*
  field 'genero' must match pattern: [\\p{L}\\p{M}\\s.'-]*
  field 'idioma' must match pattern: [\\p{L}\\p{M}\\s.'-]*
}

