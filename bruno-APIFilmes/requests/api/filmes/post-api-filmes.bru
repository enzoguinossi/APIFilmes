meta {
  name: Cadastrar filme
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/filmes
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "anoLancamento": 2026,
    "classificacaoIndicativa": "Enzo Adventures",
    "diretor": "Fabiano Schmidth",
    "duracaoMinutos": 300,
    "genero": "Aventura",
    "idioma": "PT",
    "nota": 9,
    "titulo": "{{$randomLoremWord}}"
  }
}

docs {
  Cria um novo filme no banco de dados.
}
