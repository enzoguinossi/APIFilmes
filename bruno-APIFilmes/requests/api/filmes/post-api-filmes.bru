meta {
  name: Cadastrar filme
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/filmes
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "anoLancamento": 1964,
    "classificacaoIndicativa": "{{$randomLoremWord}}",
    "diretor": "{{$randomLoremWord}}",
    "duracaoMinutos": 300,
    "genero": "{{$randomLoremWord}}",
    "idioma": "{{$randomLocale}}",
    "nota": 5.0,
    "titulo": "{{$randomLoremWord}}"
  }
}

docs {
  Cria um novo filme no banco de dados.
  field 'diretor' must match pattern: [\\p{L}\\p{M}\\s.'-]*
  field 'genero' must match pattern: [\\p{L}\\p{M}\\s.'-]*
  field 'idioma' must match pattern: [\\p{L}\\p{M}\\s.'-]*
}

